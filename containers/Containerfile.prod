# Production image: server (FastAPI) + sandbox venv in one container.
# Built by .github/workflows/main.yml and pulled by the server's deploy timer.

FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
  libgl1 \
  libxrender1 \
  libglib2.0-0 \
  libgomp1 \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1001 app && \
  useradd -m -u 1001 -g 1001 -s /bin/bash app && \
  mkdir -p /venvs /data && \
  chown -R app:app /venvs /data

USER app

# sandbox first: its scientific dependencies are the slow layer and change rarely
COPY --chown=app:app sandbox /tmp/sandbox
RUN python3 -m venv /venvs/sandbox && \
  /venvs/sandbox/bin/pip install --no-cache-dir /tmp/sandbox && \
  rm -rf /tmp/sandbox

COPY --chown=app:app server /tmp/server
RUN python3 -m venv /venvs/server && \
  /venvs/server/bin/pip install --no-cache-dir /tmp/server && \
  rm -rf /tmp/server

WORKDIR /home/app
EXPOSE 8080
ENTRYPOINT ["/venvs/server/bin/pywebtool"]
